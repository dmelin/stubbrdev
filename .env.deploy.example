# Copy to .env next to compose.yaml on the server. Only these values are
# read by compose; everything else is fixed in compose.yaml.

PROJECT_NAME=stubbr
BASE_DOMAIN=192-168-0-168.sslip.io
APP_URL=https://stubbr.192-168-0-168.sslip.io

APP_KEY=base64:generate-with-php-artisan-key:generate--show
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
EMAIL_HASH_SECRET=change-me

LOG_LEVEL=warning

MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@stubbr.dev
